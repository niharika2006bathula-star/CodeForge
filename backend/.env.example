# CodeForge Backend Environment Configuration Template
# Copy this file to backend/.env and configure your credentials.
# NEVER commit the real backend/.env file to version control.

# JDoodle API Credentials (Get from https://www.jdoodle.com/compiler-api/)
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# Flask Server Configuration
PORT=5000
DEBUG=True

# Flask Session Secret Key — Generate using: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here

# Groq AI Assistant (Get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
